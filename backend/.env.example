# Export these in the API and worker process environments. Never commit actual values.
CIVITAS_LLM_BASE_URL=http://127.0.0.1:42516/v1
CIVITAS_LLM_MODEL=unicron-local
# Optional bearer token for Qwen/vLLM. Keep the inference port private.
CIVITAS_LLM_API_KEY=
# Required for an API exposed beyond localhost. Supply a long random secret.
CIVITAS_API_KEY=
# Set this to your existing SQLite path; do not replace or recreate your database.
# CIVITAS_DB_PATH=backend/data/unicron_workspace.sqlite3
